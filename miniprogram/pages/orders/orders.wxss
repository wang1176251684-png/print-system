.container {
  background-color: #0a0a0a;
  color: #ffffff;
  min-height: 100vh;
  padding: 20rpx;
}

/* 顶部导航 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 40rpx;
}

.nav-back {
  font-size: 32rpx;
  color: #00e5ff;
}

.nav-title {
  font-size: 28rpx;
  font-weight: bold;
}

.nav-placeholder {
  width: 32rpx;
}

/* 标签切换 */
.tab-bar {
  display: flex;
  background-color: #111;
  border-radius: 12rpx;
  padding: 10rpx;
  margin-bottom: 40rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.tab-item.active {
  background-color: #00e5ff;
  color: #0a0a0a;
  font-weight: bold;
}

/* 订单列表 */
.orders-list {
  margin-bottom: 40rpx;
}

.order-item {
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #333;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-id {
  font-size: 24rpx;
  font-weight: bold;
  color: #00e5ff;
}

.order-status {
  font-size: 20rpx;
  color: #00e5ff;
  background-color: rgba(0, 229, 255, 0.1);
  padding: 5rpx 15rpx;
  border-radius: 12rpx;
}

.order-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-file {
  display: flex;
  align-items: center;
  flex: 1;
}

.file-icon {
  width: 60rpx;
  height: 60rpx;
  background-color: #222;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 20rpx;
  color: #00e5ff;
}

.file-info {
  flex: 1;
}

.file-name {
  font-size: 24rpx;
  margin-bottom: 8rpx;
  display: block;
}

.file-details {
  font-size: 18rpx;
  color: #888;
}

.order-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #333;
  padding-top: 20rpx;
}

.order-time {
  font-size: 18rpx;
  color: #888;
}

.order-action {
  font-size: 20rpx;
  color: #00e5ff;
}

/* 空订单状态 */
.empty-orders {
  text-align: center;
  padding: 100rpx 0;
}

.empty-orders text {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.new-order-btn {
  width: 200rpx;
  height: 60rpx;
  background-color: #00e5ff;
  color: #0a0a0a;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.new-order-btn::after {
  border-radius: 30rpx;
}