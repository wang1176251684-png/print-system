.container {
  background-color: #0a0a0a;
  color: #ffffff;
  min-height: 100vh;
  padding: 20rpx;
}

/* 顶部导航 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 40rpx;
}

.nav-back {
  font-size: 32rpx;
  color: #00e5ff;
}

.nav-title {
  font-size: 28rpx;
  font-weight: bold;
}

.nav-save {
  font-size: 24rpx;
  color: #00e5ff;
  font-weight: bold;
}

/* 备注输入区域 */
.remarks-section {
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.remarks-label {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.remarks-input {
  width: 100%;
  height: 300rpx;
  background-color: #1a1a1a;
  border-radius: 8rpx;
  border: 1rpx solid #333;
  color: #ffffff;
  padding: 20rpx;
  font-size: 22rpx;
  resize: none;
}

.placeholder {
  color: #888;
}

.remarks-count {
  display: block;
  text-align: right;
  font-size: 20rpx;
  color: #888;
  margin-top: 10rpx;
}

/* 提示信息 */
.tips-section {
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
}

.tips-title {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #00e5ff;
}

.tips-content {
  display: block;
  font-size: 20rpx;
  color: #888;
  margin-bottom: 10rpx;
  line-height: 1.5;
}