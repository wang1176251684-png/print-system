.container {
  background-color: #0a0a0a;
  color: #ffffff;
  min-height: 100vh;
  padding: 20rpx;
}

/* 顶部导航 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 40rpx;
}

.nav-back {
  font-size: 32rpx;
  color: #00e5ff;
}

.nav-title {
  font-size: 28rpx;
  font-weight: bold;
}

.nav-placeholder {
  width: 32rpx;
}

/* 选择选项 */
.select-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.option-card {
  background-color: #111;
  padding: 30rpx;
  border-radius: 12rpx;
  border: 1rpx solid #333;
  display: flex;
  align-items: center;
}

.option-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.option-title {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.option-hint {
  font-size: 20rpx;
  color: #888;
}

/* 已选文件 */
.selected-files {
  margin-bottom: 120rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
}

.file-count {
  font-size: 24rpx;
  color: #00e5ff;
}

.files-list {
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
}

.file-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #333;
}

.file-item:last-child {
  border-bottom: none;
}

.file-icon {
  width: 60rpx;
  height: 60rpx;
  background-color: #222;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 20rpx;
  color: #00e5ff;
}

.file-info {
  flex: 1;
}

.file-name {
  font-size: 24rpx;
  margin-bottom: 8rpx;
  display: block;
}

.file-size {
  font-size: 18rpx;
  color: #888;
}

.file-remove {
  width: 40rpx;
  height: 40rpx;
  background-color: #333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ff4d4f;
}

.empty-files {
  text-align: center;
  padding: 40rpx;
  color: #888;
}

/* 底部按钮 */
.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #111;
  padding: 20rpx;
  border-top: 1rpx solid #333;
  display: flex;
  gap: 20rpx;
}

.continue-btn {
  flex: 1;
  height: 80rpx;
  background-color: #222;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.complete-btn {
  flex: 1;
  height: 80rpx;
  background-color: #00e5ff;
  color: #0a0a0a;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 12rpx;
}

.continue-btn::after,
.complete-btn::after {
  border-radius: 12rpx;
}