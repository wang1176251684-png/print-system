.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.section {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: white;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
}

.label {
  width: 180rpx;
  font-size: 32rpx;
}

.input {
  flex: 1;
  height: 60rpx;
  border: 1rpx solid #ddd;
  border-radius: 5rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
}

.unit {
  margin-left: 20rpx;
  font-size: 32rpx;
  color: #666;
}

.save-btn {
  width: 100%;
  height: 80rpx;
  background-color: #1890ff;
  color: white;
  font-size: 32rpx;
  border-radius: 10rpx;
  margin-top: 40rpx;
}

.save-btn::after {
  border-radius: 10rpx;
}