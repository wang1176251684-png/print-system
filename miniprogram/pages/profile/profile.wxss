.container {
  background-color: #0a0a0a;
  color: #ffffff;
  min-height: 100vh;
  padding: 20rpx;
}

/* 顶部用户信息 */
.user-section {
  display: flex;
  align-items: center;
  background-color: #111;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.user-phone {
  font-size: 24rpx;
  color: #888;
}

/* 功能列表 */
.function-section {
  background-color: #111;
  border-radius: 12rpx;
  margin-bottom: 120rpx;
}

.function-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #333;
}

.function-item:last-child {
  border-bottom: none;
}

.function-icon {
  font-size: 32rpx;
  margin-right: 30rpx;
}

.function-name {
  flex: 1;
  font-size: 24rpx;
}

.function-arrow {
  font-size: 24rpx;
  color: #888;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #111;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #333;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 18rpx;
  color: #888;
}

.nav-item.active {
  color: #00e5ff;
}

.nav-icon {
  font-size: 32rpx;
  margin-bottom: 5rpx;
}