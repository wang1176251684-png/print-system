.container {
  background-color: #0a0a0a;
  color: #ffffff;
  min-height: 100vh;
  padding: 20rpx;
}

/* 顶部导航 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 40rpx;
}

.nav-back {
  font-size: 32rpx;
  color: #00e5ff;
}

.nav-title {
  font-size: 28rpx;
  font-weight: bold;
}

.nav-placeholder {
  width: 32rpx;
}

/* 已选文件 */
.file-info {
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.file-item {
  display: flex;
  align-items: center;
}

.file-icon {
  width: 60rpx;
  height: 60rpx;
  background-color: #222;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 20rpx;
  color: #00e5ff;
}

.file-info text {
  display: block;
}

.file-name {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.file-size {
  font-size: 18rpx;
  color: #888;
}

.more-files {
  font-size: 20rpx;
  color: #888;
  margin-top: 10rpx;
  display: block;
}

/* 打印设置选项 */
.settings-section {
  margin-bottom: 40rpx;
}

.setting-group {
  margin-bottom: 30rpx;
}

.setting-title {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #ffffff;
}

.checkbox-group {
  display: flex;
  gap: 30rpx;
  flex-wrap: wrap;
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.checkbox-item.active {
  color: #00e5ff;
}

.checkbox-item.disabled {
  color: #888;
}

/* 份数控制 */
.copies-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.control-btn {
  width: 60rpx;
  height: 60rpx;
  background-color: #111;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ffffff;
  border: 1rpx solid #333;
}

.control-btn[disabled] {
  color: #888;
  border-color: #333;
}

.copies-value {
  flex: 1;
  height: 60rpx;
  background-color: #111;
  border-radius: 8rpx;
  border: 1rpx solid #333;
  color: #ffffff;
  text-align: center;
  font-size: 24rpx;
  line-height: 60rpx;
}

/* 备注按钮 */
.remarks-btn {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #111;
  border-radius: 8rpx;
  border: 1rpx solid #333;
  padding: 20rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.remarks-arrow {
  font-size: 20rpx;
  color: #888;
}

/* 预估价格 */
.price-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.price-label {
  font-size: 24rpx;
}

.price-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

/* 确认打印按钮 */
.confirm-btn {
  width: 100%;
  height: 80rpx;
  background-color: #00e5ff;
  color: #0a0a0a;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}

.confirm-btn::after {
  border-radius: 12rpx;
}