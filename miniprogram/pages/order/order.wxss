.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.section {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: white;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
}

.label {
  width: 150rpx;
  font-size: 32rpx;
}

.input {
  flex: 1;
  height: 60rpx;
  border: 1rpx solid #ddd;
  border-radius: 5rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
}

.price-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: white;
  margin-bottom: 40rpx;
  border-radius: 10rpx;
}

.price-label {
  font-size: 32rpx;
  font-weight: bold;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.confirm-btn {
  width: 100%;
  height: 80rpx;
  background-color: #1890ff;
  color: white;
  font-size: 32rpx;
  border-radius: 10rpx;
}

.confirm-btn::after {
  border-radius: 10rpx;
}