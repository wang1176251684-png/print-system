.container {
  background-color: #0a0a0a;
  color: #ffffff;
  min-height: 100vh;
  padding: 20rpx;
}

/* 顶部 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header h1 {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #00e5ff;
}

.subtitle {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.tagline {
  font-size: 20rpx;
  color: #666;
}

/* 上传文件区域 */
.upload-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #ffffff;
}

.upload-options {
  display: flex;
  gap: 20rpx;
}

.upload-btn {
  flex: 1;
  background-color: #111;
  padding: 30rpx;
  border-radius: 12rpx;
  text-align: center;
  border: 1rpx solid #333;
}

.icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.upload-btn text {
  display: block;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.hint {
  font-size: 18rpx;
  color: #888;
}

/* 已选文件 */
.files-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.clear-btn, .edit-btn {
  font-size: 20rpx;
  color: #00e5ff;
}

.files-list {
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
}

.file-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #333;
}

.file-item:last-child {
  border-bottom: none;
}

.file-icon {
  width: 60rpx;
  height: 60rpx;
  background-color: #222;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 20rpx;
  color: #00e5ff;
}

.file-info {
  flex: 1;
}

.file-name {
  font-size: 24rpx;
  margin-bottom: 8rpx;
  display: block;
}

.file-size {
  font-size: 18rpx;
  color: #888;
}

.file-remove {
  width: 40rpx;
  height: 40rpx;
  background-color: #333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ff4d4f;
}

.empty-files {
  text-align: center;
  padding: 40rpx;
  color: #888;
}

/* 打印设置 */
.settings-section {
  margin-bottom: 40rpx;
}

.settings-grid {
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  background-color: #1a1a1a;
  border-radius: 8rpx;
}

.setting-label {
  font-size: 22rpx;
  color: #888;
}

.setting-value {
  font-size: 22rpx;
  color: #00e5ff;
}

/* 预估价格 */
.price-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #111;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.price-label {
  font-size: 24rpx;
}

.price-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.price-hint {
  font-size: 20rpx;
  color: #888;
}

/* 立即下单按钮 */
.order-btn {
  width: 100%;
  height: 80rpx;
  background-color: #00e5ff;
  color: #0a0a0a;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
  margin-bottom: 100rpx;
}

.order-btn::after {
  border-radius: 12rpx;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #111;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid #333;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 18rpx;
  color: #888;
}

.nav-item.active {
  color: #00e5ff;
}

.nav-icon {
  font-size: 32rpx;
  margin-bottom: 5rpx;
}